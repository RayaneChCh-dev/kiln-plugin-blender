{
 "openapi": "3.1.0",
 "info": {
  "title": "Queue OpenAPI for kling/v4/image-to-video",
  "version": "1.0.0",
  "description": "The OpenAPI schema for the kling/v4/image-to-video queue.",
  "x-fal-metadata": {
   "endpointId": "kling/v4/image-to-video",
   "category": "image-to-video",
   "thumbnailUrl": "https://v3b.fal.media/files/b/0aaea00f/kDSSuRNelHs4Q40pk4QFR.jpg",
   "playgroundUrl": "https://fal.ai/models/kling/v4/image-to-video",
   "documentationUrl": "https://fal.ai/models/kling/v4/image-to-video/api",
   "about": "Generate videos with Kling 4.0 Image to Video"
  }
 },
 "components": {
  "securitySchemes": {
   "apiKeyAuth": {
    "type": "apiKey",
    "in": "header",
    "name": "Authorization",
    "description": "Fal Key"
   }
  },
  "schemas": {
   "QueueStatus": {
    "type": "object",
    "properties": {
     "status": {
      "type": "string",
      "enum": [
       "IN_QUEUE",
       "IN_PROGRESS",
       "COMPLETED"
      ]
     },
     "request_id": {
      "type": "string",
      "description": "The request id."
     },
     "response_url": {
      "type": "string",
      "description": "The response url."
     },
     "status_url": {
      "type": "string",
      "description": "The status url."
     },
     "cancel_url": {
      "type": "string",
      "description": "The cancel url."
     },
     "logs": {
      "type": "object",
      "description": "The logs.",
      "additionalProperties": true
     },
     "metrics": {
      "type": "object",
      "description": "The metrics.",
      "additionalProperties": true
     },
     "queue_position": {
      "type": "integer",
      "description": "The queue position."
     }
    },
    "required": [
     "status",
     "request_id"
    ]
   },
   "V4ImageToVideoInput": {
    "title": "ImageToVideoInput",
    "properties": {
     "duration": {
      "minimum": 3,
      "title": "Duration",
      "maximum": 30,
      "default": 5,
      "description": "Video duration in seconds (3-30).",
      "type": "integer"
     },
     "prompt": {
      "anyOf": [
       {
        "maxLength": 26000,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Prompt",
      "description": "Text prompt. Either prompt or multi_prompt must be provided.",
      "examples": [
       "A detective in a black trench coat stands on a rooftop in the rain, looking through a telescope at the street below."
      ]
     },
     "multi_prompt": {
      "anyOf": [
       {
        "minItems": 1,
        "items": {
         "$ref": "#/components/schemas/KlingV4Shot"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "title": "Multi Prompt",
      "description": "Per-shot prompts for multi-shot generation. The video duration is the sum of the shot durations.",
      "examples": [
       null
      ]
     },
     "end_image_url": {
      "anyOf": [
       {
        "x-fal": {
         "min_height": 300,
         "max_aspect_ratio": 2.5,
         "timeout": 20,
         "max_file_size": 31457280,
         "min_width": 300,
         "min_aspect_ratio": 0.4
        },
        "ui": {
         "field": "image"
        },
        "type": "string",
        "limit_description": "Max file size: 30.0MB, Min width: 300px, Min height: 300px, Min aspect ratio: 0.40, Max aspect ratio: 2.50, Timeout: 20.0s"
       },
       {
        "type": "null"
       }
      ],
      "title": "End Image Url",
      "description": "Image to use as the last frame of the video.",
      "examples": [
       "https://v3b.fal.media/files/b/tiger/BwHi22qoQnqaTNMMhe533.png"
      ]
     },
     "resolution": {
      "enum": [
       "720p",
       "1080p"
      ],
      "title": "Resolution",
      "default": "1080p",
      "description": "Output resolution.",
      "type": "string"
     },
     "middle_image_urls": {
      "anyOf": [
       {
        "items": {
         "x-fal": {
          "min_height": 300,
          "max_aspect_ratio": 2.5,
          "timeout": 20,
          "max_file_size": 31457280,
          "min_width": 300,
          "min_aspect_ratio": 0.4
         },
         "_fal_ui_field": "image",
         "ui": {
          "field": "image"
         },
         "type": "string",
         "limit_description": "Max file size: 30.0MB, Min width: 300px, Min height: 300px, Min aspect ratio: 0.40, Max aspect ratio: 2.50, Timeout: 20.0s"
        },
        "type": "array",
        "maxItems": 8
       },
       {
        "type": "null"
       }
      ],
      "title": "Middle Image Urls",
      "description": "Ordered keyframes between the first and last frames (max 8).",
      "examples": [
       null
      ]
     },
     "start_image_url": {
      "x-fal": {
       "min_height": 300,
       "max_aspect_ratio": 2.5,
       "timeout": 20,
       "max_file_size": 31457280,
       "min_width": 300,
       "min_aspect_ratio": 0.4
      },
      "title": "Start Image Url",
      "description": "Image to use as the first frame of the video.\n\nMax file size: 30.0MB, Min width: 300px, Min height: 300px, Min aspect ratio: 0.40, Max aspect ratio: 2.50, Timeout: 20.0s",
      "type": "string",
      "examples": [
       "https://v3b.fal.media/files/b/rabbit/NaslJIC7F2WodS6DFZRRJ.png"
      ]
     }
    },
    "required": [
     "start_image_url"
    ],
    "description": "The output aspect ratio follows the input frames.",
    "type": "object",
    "x-fal-order-properties": [
     "prompt",
     "start_image_url",
     "middle_image_urls",
     "end_image_url",
     "multi_prompt",
     "duration",
     "resolution"
    ]
   },
   "V4ImageToVideoOutput": {
    "properties": {
     "video": {
      "$ref": "#/components/schemas/File",
      "description": "The generated video.",
      "examples": [
       {
        "content_type": "video/mp4",
        "url": "https://v3b.fal.media/files/b/0aac4496/HjUbnyfTPVcavQNpRh1QJ_clip_image.mp4",
        "file_size": 2953131,
        "file_name": "output.mp4"
       }
      ]
     }
    },
    "required": [
     "video"
    ],
    "title": "ImageToVideoOutput",
    "type": "object",
    "x-fal-order-properties": [
     "video"
    ]
   },
   "KlingV4Shot": {
    "properties": {
     "duration": {
      "title": "Duration",
      "maximum": 30,
      "default": 5,
      "description": "Shot duration in seconds.",
      "type": "integer",
      "minimum": 1
     },
     "prompt": {
      "maxLength": 512,
      "title": "Prompt",
      "description": "The prompt for this shot.",
      "type": "string",
      "minLength": 1
     }
    },
    "required": [
     "prompt"
    ],
    "title": "KlingV4Shot",
    "type": "object",
    "x-fal-order-properties": [
     "prompt",
     "duration"
    ]
   },
   "File": {
    "properties": {
     "content_type": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Content Type",
      "description": "The mime type of the file.",
      "examples": [
       "image/png"
      ]
     },
     "url": {
      "title": "Url",
      "description": "The URL where the file can be downloaded from.",
      "type": "string"
     },
     "file_size": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "File Size",
      "description": "The size of the file in bytes.",
      "examples": [
       4404019
      ]
     },
     "file_name": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "File Name",
      "description": "The name of the file. It will be auto-generated if not provided.",
      "examples": [
       "z9RV14K95DvU.png"
      ]
     }
    },
    "required": [
     "url"
    ],
    "title": "File",
    "type": "object",
    "x-fal-order-properties": [
     "url",
     "content_type",
     "file_name",
     "file_size"
    ]
   }
  }
 },
 "paths": {
  "/kling/v4/image-to-video/requests/{request_id}/status": {
   "get": {
    "parameters": [
     {
      "name": "request_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "description": "Request ID"
      }
     },
     {
      "name": "logs",
      "in": "query",
      "required": false,
      "schema": {
       "type": "number",
       "description": "Whether to include logs (`1`) in the response or not (`0`)."
      }
     }
    ],
    "responses": {
     "200": {
      "description": "The request status.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/QueueStatus"
        }
       }
      }
     }
    }
   }
  },
  "/kling/v4/image-to-video/requests/{request_id}/cancel": {
   "put": {
    "parameters": [
     {
      "name": "request_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "description": "Request ID"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "The request was cancelled.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "success": {
           "type": "boolean",
           "description": "Whether the request was cancelled successfully."
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "/kling/v4/image-to-video": {
   "post": {
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/V4ImageToVideoInput"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "The request status.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/QueueStatus"
        }
       }
      }
     }
    }
   }
  },
  "/kling/v4/image-to-video/requests/{request_id}": {
   "get": {
    "parameters": [
     {
      "name": "request_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "description": "Request ID"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Result of the request.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/V4ImageToVideoOutput"
        }
       }
      }
     }
    }
   }
  }
 },
 "servers": [
  {
   "url": "https://queue.fal.run"
  }
 ],
 "security": [
  {
   "apiKeyAuth": []
  }
 ]
}
